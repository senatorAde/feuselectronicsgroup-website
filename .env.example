# ─────────────────────────────────────────────────
# FEUS Electronics Group — Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ═══════════════════════════════════════════════════
# OPTION A — EmailJS (Frontend-only, fastest setup)
# ═══════════════════════════════════════════════════
# Sign up at https://www.emailjs.com
# Create an email service, email template, and get your public key.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ═══════════════════════════════════════════════════
# OPTION B — Backend API (Production-grade)
# ═══════════════════════════════════════════════════
# Choose ONE of the following email providers:

# --- Resend (recommended) ---
# Sign up at https://resend.com
RESEND_API_KEY=re_your_api_key

# --- SendGrid ---
# Sign up at https://sendgrid.com
# SENDGRID_API_KEY=SG.your_api_key

# --- Nodemailer (SMTP) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Email destination for contact form submissions
CONTACT_EMAIL_TO=info@feuselectronicsgroup.com
CONTACT_EMAIL_FROM=noreply@feuselectronicsgroup.com

# ═══════════════════════════════════════════════════
# SCHEDULING (optional)
# ═══════════════════════════════════════════════════
# Leave both unset unless you have a live, bookable event URL. When they are
# unset, every booking call to action routes to the contact form, which is
# always answered. Setting them to a URL that no longer accepts bookings is
# worse than leaving them empty: visitors reach a scheduling error at the exact
# moment they try to buy, and nothing on the site reports it.
#
# The URL must be https, on calendly.com, and point at a specific event
# (https://calendly.com/<user>/<event>) -- a bare profile is not bookable.
# VITE_CALENDLY_URL=https://calendly.com/your-account/your-event
#
# Server-side equivalent, used only for the booking link in the contact
# auto-reply. Omit it and the auto-reply offers to send times by email instead.
# BOOKING_URL=https://calendly.com/your-account/your-event
